<configuration>
    <!-- Single pipeline: all logs go through the OpenTelemetry logs SDK (see plugins/OpenTelemetry.kt).
         The interim `console` logs exporter prints records to System.out, so the OTEL appender is the
         only root appender — adding STDOUT back would double every line. STDOUT is kept defined but
         unreferenced so dev-pretty console output is a one-line change to re-enable. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureCodeAttributes>true</captureCodeAttributes>
        <captureMarkerAttribute>true</captureMarkerAttribute>
        <!-- `*` selects every key; the 2.33 replacements for captureKeyValuePairAttributes/captureMdcAttributes. -->
        <keyValuePairAttributesIncluded>*</keyValuePairAttributesIncluded>
        <mdcAttributesIncluded>*</mdcAttributesIncluded>
        <numLogsCapturedBeforeOtelInstall>1000</numLogsCapturedBeforeOtelInstall>
    </appender>
    <root level="INFO">
        <appender-ref ref="OTEL"/>
    </root>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
    <!-- Log hygiene (security.md): these two log a failure's message below INFO, and a database failure's message can carry bound values.
         Exposed's retry logger prints "Transaction attempt #N failed: ${cause.message}" at DEBUG; StatusPages traces the request URI
         (query string included) and `cause.toString()` at TRACE. Pinned to INFO so a root-level change cannot switch them on.
         The same for the R2DBC driver (its QUERY and PARAM loggers print every statement with its bound values at DEBUG, and inherit this
         pin) and for Ktor's authentication and rate-limit loggers, which trace `request.uri` (the query string included). -->
    <logger name="Exposed" level="INFO"/>
    <logger name="io.ktor.server.plugins.statuspages" level="INFO"/>
    <logger name="io.r2dbc.postgresql" level="INFO"/>
    <logger name="io.ktor.server.auth.Authentication" level="INFO"/>
    <logger name="io.ktor.server.plugins.ratelimit.RateLimit" level="INFO"/>
</configuration>